<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - BriSky</title>
    
    <link href="~/Content/Site.css?v=2" rel="stylesheet" />
    <link href="~/Content/Sidebar.css?v=2" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server"></asp:ScriptManager>
        
        <div class="wrapper">
            <!-- Sidebar -->
            <nav id="sidebar" runat="server">
                <div class="sidebar-header">
                    <i class="fa-solid fa-plane logo-icon"></i>
                    <span class="logo-text">BriSky</span>
                </div>

                <ul class="list-unstyled components">
                    <li>
                        <a href="~/" runat="server"><i class="fa-solid fa-house"></i> <span>Inicio</span></a>
                    </li>
                    <li class="has-submenu" id="menuGestion" runat="server">
                        <a href="#gestionSubmenu" class="dropdown-toggle" aria-expanded="false">
                            <i class="fa-solid fa-briefcase"></i> <span>Gestión</span>
                        </a>
                        <ul class="collapse list-unstyled" id="gestionSubmenu">
                            <li><a href="~/Pages/Ubicaciones" runat="server">Ubicaciones</a></li>
                            <li><a href="~/Pages/Empleados" runat="server">Empleados</a></li>
                            <li><a href="~/Pages/Pasajeros" runat="server">Pasajeros</a></li>
                            <li><a href="~/Pages/Tarifas" runat="server">Tarifas</a></li>
                        </ul>
                    </li>
                    <li class="has-submenu" id="menuFlota" runat="server">
                        <a href="#flotaSubmenu" class="dropdown-toggle" aria-expanded="false">
                            <i class="fa-solid fa-plane-up"></i> <span>Flota</span>
                        </a>
                        <ul class="collapse list-unstyled" id="flotaSubmenu">
                            <li><a href="~/Pages/Flota" runat="server">Flota</a></li>
                            <li><a href="~/Pages/Mantenimiento" runat="server">Mantenimiento</a></li>
                        </ul>
                    </li>
                    <li class="has-submenu" id="menuOperaciones" runat="server">
                        <a href="#operacionesSubmenu" class="dropdown-toggle" aria-expanded="false">
                            <i class="fa-solid fa-gears"></i> <span>Operaciones</span>
                        </a>
                        <ul class="collapse list-unstyled" id="operacionesSubmenu">
                            <li><a href="~/Pages/Rutas" runat="server">Rutas</a></li>
                            <li><a href="~/Pages/Vuelos" runat="server">Vuelos</a></li>
                            <li><a href="~/Pages/Tripulacion" runat="server">Tripulación</a></li>
                        </ul>
                    </li>
                    <li class="has-submenu">
                        <a href="#reservasSubmenu" class="dropdown-toggle" aria-expanded="false">
                            <i class="fa-solid fa-ticket"></i> <span>Reservas</span>
                        </a>
                        <ul class="collapse list-unstyled" id="reservasSubmenu">
                            <li><a href="~/Pages/Reservas" runat="server">Reservas</a></li>
                            <li><a href="~/Pages/Boletos" runat="server">Boletos</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>

            <!-- Page Content -->
            <div id="content">
                <nav id="topNavbar" class="navbar top-navbar" runat="server">
                    <div class="container-fluid" style="display: flex; justify-content: space-between; width: 100%;">
                        <button type="button" id="sidebarCollapse" class="btn-toggle" runat="server">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        
                        <asp:LinkButton ID="btnVolverInicio" runat="server" OnClick="btnVolverInicio_Click" Visible="false" style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.4); border-radius: 8px; text-decoration: none; padding: 10px 20px; font-weight: bold; transition: all 0.3s;">
                            <i class="fa-solid fa-house"></i> Volver a Selección de Rol
                        </asp:LinkButton>
                    </div>
                </nav>

                <div class="main-container">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <script src="<%= ResolveUrl("~/Scripts/sidebar.js") %>"></script>
    </form>
</body>
</html>
